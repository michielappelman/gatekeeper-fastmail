{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-fastmail",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  // What readAttachmentAsMarkdown()'s conversion runs on (env.WORKERS_AI.toMarkdown()), the same
  // mechanism the Workshop's webFetch agent tool uses.
  "ai": { "binding": "WORKERS_AI" },
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "FastmailGatekeeperImpl"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
